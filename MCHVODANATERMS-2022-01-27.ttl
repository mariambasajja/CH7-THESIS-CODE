    <https://github.com/mariambasajja/mchvodanatermsConditionofmotheratadmission>, <https://github.com/mariambasajja/mchvodanatermsConditionofmotheratdischarge>,
    <https://github.com/mariambasajja/mchvodanatermsConditionofmotheronadmission>, <https://github.com/mariambasajja/mchvodanatermsGenderofbaby>,
    <https://github.com/mariambasajja/mchvodanatermsLevelofeducationofMother>, <https://github.com/mariambasajja/mchvodanatermsLivebirth>,
    <https://github.com/mariambasajja/mchvodanatermsMaritalstatus>, <https://github.com/mariambasajja/mchvodanatermsModeofdelivery>,
    <https://github.com/mariambasajja/mchvodanatermsMortalitystatus>;
  skos:prefLabel "This is the ontology containing controlled terms and properties of the maternal child health generic template used within the different facilities"@en .

<https://github.com/mariambasajja/mchvodanatermsReasonforadmission> a owl:ObjectProperty;
  rdfs:label "Reason for admission"@en;
  skos:definition "This is the reason for admitting a patient"@en;
  skos:prefLabel "Reason for admission"@en .

