<https://github.com/mariambasajja/mchvodanaterms> a skos:ConceptScheme;
  dct:creator <https://orcid.org/0000-0001-7710-8843>;
  dct:description "Ontology containing the controlled terms and semantic properties used in the COVID-19 generic template used within different facilities in VODANA"@en;
  dct:title "This is the ontology containing controlled terms and properties of the maternal child health generic template used within the different facilities"@en;
  pav:createdOn "2022-01-14T22:00:00+01:00"@en;
  pav:lastUpdatedOn "2022-016-14T16:32:00-08:00"@en;
  pav:version "0.0.1"@en;
