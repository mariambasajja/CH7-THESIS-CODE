<https://github.com/mariambasajja/vocablary1/> a skos:ConceptScheme;
  dct:creator <http://orcid.org/0000-0001-7710-8843>;
  dct:description "This is the ontology containing controlled terms and properties for the data collected using the Out Patient Register in Uganda."@en;
  dct:title "This is the ontology containing controlled terms and properties for the data collected using the Out Patient Register in Uganda."@en;
  pav:createdOn "2021-05-27T00:00:00+01:00"@en;
  pav:lastUpdatedOn "2022-01-107T14:30:00+01:00"@en;
  pav:version "0.2"@en;
  skos:hasTopConcept vocablary1:Disability, vocablary1:Fever, vocablary1:LabTuberculosisResult,
    vocablary1:LinkedtoTuberculosisClinic, vocablary1:MalariaTestsDone, vocablary1:PatientCategory,
    vocablary1:PatientSentToTheLab, vocablary1:PresumedTuberculosisCase, vocablary1:Sex,
    vocablary1:Tickclassification;
  skos:prefLabel "This is the ontology containing controlled terms and properties for the data collected using the Out Patient Register in Uganda."@en .

